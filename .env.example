# Lahore Air Quality Intelligence Platform
# Copy to .env and fill in values. Never commit real secrets.
#
#   cp .env.example .env
#
# Values below are safe local-development defaults (Compose stack).
# Replace credentials before any shared or production use.
#
# Host tools (pytest, alembic, dbt on the host) use localhost hosts below.
# Containers override discovery hosts in docker-compose.yml
# (postgres, redpanda:9092, http://minio:9000, http://mlflow:5000).

# --- External APIs ---
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org
OPENMETEO_BASE_URL=https://api.open-meteo.com
OPENMETEO_ARCHIVE_BASE_URL=https://archive-api.open-meteo.com

# --- Geography (Lahore WGS84) ---
LAHORE_LATITUDE=31.5204
LAHORE_LONGITUDE=74.3587

# --- Poller ---
POLL_INTERVAL_SECONDS=300
POLL_ONCE=false
POLL_ENABLE_OPENAQ=true
POLL_ENABLE_OPENMETEO=true
LOG_LEVEL=INFO
LOG_JSON=true

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lahore_aqi
POSTGRES_USER=lahore
POSTGRES_PASSWORD=change_me

# --- Redpanda (Kafka-compatible) ---
# Host clients: localhost:19092 — Compose services use redpanda:9092 internally.
REDPANDA_BROKERS=localhost:19092
REDPANDA_TOPIC_AIR_QUALITY=aq.raw
REDPANDA_TOPIC_WEATHER=weather.raw
REDPANDA_CONSUMER_GROUP=lahore-aqi-consumer
REDPANDA_KAFKA_PORT=19092
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_PANDAPROXY_PORT=18082
REDPANDA_ADMIN_PORT=19644
REDPANDA_CONSOLE_PORT=8085

# --- S3-compatible object storage ---
# Compose uses Adobe S3Mock (service name `minio`) on host :9000 → container :9090.
# Inside Compose, services use http://minio:9090 (set in docker-compose.yml).
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=lahore-aqi-raw
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
MINIO_API_PORT=9000

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_PORT=5000

# --- Dagster ---
DAGSTER_PORT=3000

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Browser origins allowed to call the API (dashboard nginx + local Vite).
API_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# --- Dashboard (baked into the static build at image build time) ---
# Must be reachable from the browser (usually host-mapped API URL).
VITE_API_BASE_URL=http://localhost:8000
DASHBOARD_PORT=8080
