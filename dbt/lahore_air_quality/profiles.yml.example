# Copy to profiles.yml in this directory and run with:
#   export DBT_PROFILES_DIR="$(pwd)/dbt/lahore_air_quality"
# or merge into ~/.dbt/profiles.yml.
#
# Credentials come from environment variables — never commit real passwords.

lahore_air_quality:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | int }}"
      user: "{{ env_var('POSTGRES_USER', 'lahore') }}"
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      dbname: "{{ env_var('POSTGRES_DB', 'lahore_aqi') }}"
      # Default search path; model +schema configs write to staging / intermediate / marts.
      schema: public
      threads: 4
      keepalives_idle: 0
      connect_timeout: 10
    ci:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | int }}"
      user: "{{ env_var('POSTGRES_USER') }}"
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      dbname: "{{ env_var('POSTGRES_DB') }}"
      schema: public
      threads: 2
      connect_timeout: 10
